[Unit]
Description=AI-Contour nightly sync (contour update)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ai-contour
Group=ai-contour
WorkingDirectory=/opt/ai-contour
Environment=CONTOUR_CONFIG=/etc/ai-contour/contour.yaml
ExecStart=/opt/ai-contour/venv/bin/contour --config /etc/ai-contour/contour.yaml update

[Install]
WantedBy=multi-user.target
